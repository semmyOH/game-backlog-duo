# Lokale lesomgeving. Je hoeft normaal niets te wijzigen.
# composer install maakt automatisch .env, een eigen sleutel en je database.
APP_NAME="Game Backlog"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=nl_NL
APP_MAINTENANCE_DRIVER=file
LOG_CHANNEL=single
LOG_LEVEL=debug

# Laravel gebruikt automatisch database/database.sqlite.
# Geen MySQL, databasewachtwoord of absoluut pad nodig.
DB_CONNECTION=sqlite

# Eenvoudige lokale instellingen: geen aparte queue- of mailserver nodig.
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_STORE=file
QUEUE_CONNECTION=sync
MAIL_MAILER=log
MAIL_FROM_ADDRESS="les@example.test"
MAIL_FROM_NAME="${APP_NAME}"
VITE_APP_NAME="${APP_NAME}"
